  "cards": [
    {
      "dot": "rose",
      "title": "Nothing leaves on its own",
      "items": [
        "No network request after load; the page's CSP allows only its own origin",
        "Data leaves only as a file you choose to save: a backup, or an .ics for your phone"
      ]
    },
    {
      "dot": "amber",
      "title": "Files are hostile until checked",
      "items": [
        "A backup is size-capped, then every field and key is checked before anything is written",
        "A calendar file is previewed and added only when you confirm"
      ]
    },
    {
      "dot": "emerald",
      "title": "Locked notes",
      "items": [
        "Sealed as you type; only the title is stored readable",
        "The passcode and key are never written anywhere"
      ]
    }

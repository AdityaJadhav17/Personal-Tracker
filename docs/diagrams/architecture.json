  "cards": [
    {
      "dot": "cyan",
      "title": "Opening the app",
      "items": [
        "The taskbar app loads from serve.mjs, a Node built-ins-only server on loopback",
        "Any Host but localhost or 127.0.0.1 on its port gets a 403"
      ]
    },
    {
      "dot": "emerald",
      "title": "Data",
      "items": [
        "One localStorage key holds everything, written before the screen updates",
        "Imports are parsed as hostile; every version upgrades one hop at a time"
      ]
    },
    {
      "dot": "rose",
      "title": "Security",
      "items": [
        "CSP in index.html: no network after load, no inline script",
        "Locked notes are sealed in the browser; the key never leaves memory"
      ]
    },
    {
      "dot": "amber",
      "title": "Deploy",
      "items": [
        "update.mjs deploys main only after GitHub's check named check passes",
        "It builds into the folder serve.mjs reads, then writes deployed.txt"
      ]
    }
  ]

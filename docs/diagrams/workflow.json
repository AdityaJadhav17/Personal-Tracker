  "cards": [
    {
      "dot": "cyan",
      "title": "Agree first",
      "items": [
        "Every change starts as a story with acceptance criteria",
        "No application code until you say go; over 200 lines always stops for a plan"
      ]
    },
    {
      "dot": "emerald",
      "title": "Build",
      "items": [
        "Each criterion gets a test named by its ID, seen failing before the code exists",
        "Every test runs on 15 September 2026, so results do not depend on the day"
      ]
    },
    {
      "dot": "amber",
      "title": "Ship",
      "items": [
        "You commit and push; CI runs with a read-only token",
        "The laptop deploys only a commit whose check named check passed"
      ]
    }
  ]
